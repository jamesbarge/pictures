{
	"name": "pictures-london",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ci": "vite build && E2E_PREVIEW=1 playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.0",
		"maplibre-gl": "^5.21.1",
		"minisearch": "^7.2.0",
		"posthog-js": "^1.434.15",
		"web-vitals": "^6.2.2"
	},
	"overrides": {
		"js-cookie": "^3.0.8"
	}
}
